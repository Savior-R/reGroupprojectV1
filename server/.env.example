# ============================================================================
# M1 账号与身份认证 — 配置模板
# 用法：cp .env.example .env，填入真实值。.env 已被 gitignore。
# 所有键都可通过同名环境变量覆盖（容器 / CI 场景）。
# ============================================================================

# --- 邮件发送（FR-M1-09）---
# QQ 邮箱：设置 → 账号 → POP3/IMAP/SMTP 服务 → 开启 → 生成授权码
M1_MAIL_HOST=smtp.qq.com
M1_MAIL_PORT=465
M1_MAIL_SSL=true
M1_MAIL_USERNAME=
M1_MAIL_PASSWORD=
M1_MAIL_FROM=
M1_MAIL_MOCK=false

# --- JWT 签名密钥（FR-M1-02）---
# HS256 至少 32 字节；生成：openssl rand -base64 48
M1_JWT_SECRET=

# --- 邮箱验证码 HMAC 密钥（FR-M1-09）---
# 生成：openssl rand -base64 32
M1_EMAIL_CODE_SECRET=

# --- 内部服务令牌（Nginx /_auth 调 /internal/** 用）---
# 生成：openssl rand -base64 32；须与 compose 的 INTERNAL_SERVICE_TOKEN 一致
M1_INTERNAL_TOKEN=

# --- 微信开放平台扫码（FR-M1-10）---
# 未申请资质时留空，M1_WECHAT_MOCK=true 走 Mock provider
# 端口 8090 对应 compose 的宿主机映射（8080 被本机其他项目占用）
M1_WECHAT_APP_ID=
M1_WECHAT_APP_SECRET=
M1_WECHAT_REDIRECT_URI=http://localhost:8090/api/v1/auth/oauth/wechat/callback
M1_WECHAT_MOCK=true
