# 试讲台网关（02 §2.2 / 03 §3.3）
# 由官方 nginx 镜像的 envsubst 注入 ${INTERNAL_SERVICE_TOKEN} 与 ${JAVA_UPSTREAM}。
# 注意：location 内一旦出现 proxy_set_header，就不再继承 server 级设置，
# 因此受保护路径与 WebSocket 处把清除头一并重写。

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

server {
    listen 80;
    server_name _;
    client_max_body_size 21m;

    # 外部请求不可伪造身份头：默认清空（/api/ 与 /ws/ 内部另行覆盖）
    proxy_set_header X-Account-Id "";
    proxy_set_header X-Account-Type "";
    proxy_set_header X-School-Id "";
    proxy_set_header X-Internal-Token "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # ---------------------------------------------------- 公开接口（免认证）
    location = /api/v1/auth/register {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/login {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/login/email {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/email/code {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/oauth/wechat/qr {
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/oauth/wechat/callback {
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/oauth/wechat/status {
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/oauth/wechat/exchange {
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /api/v1/auth/oauth/wechat/register {
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location ^~ /api/v1/public/ {
        proxy_pass http://${JAVA_UPSTREAM};
    }
    location = /actuator/health {
        proxy_pass http://${JAVA_UPSTREAM};
    }

    # ------------------------------------------- 受保护 API：先经 /_auth 校验
    location /api/ {
        auth_request /_auth;
        auth_request_set $account_id   $upstream_http_x_account_id;
        auth_request_set $account_type $upstream_http_x_account_type;
        auth_request_set $school_id    $upstream_http_x_school_id;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Account-Id   $account_id;
        proxy_set_header X-Account-Type $account_type;
        proxy_set_header X-School-Id    $school_id;
        proxy_set_header X-Internal-Token "";
        proxy_pass http://${JAVA_UPSTREAM};
    }

    # ------------------------------- WebSocket：不经过 auth_request，握手校验 ticket
    location /ws/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Account-Id "";
        proxy_set_header X-Account-Type "";
        proxy_set_header X-School-Id "";
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_pass http://${JAVA_UPSTREAM};
    }

    # ---------------------------------------------------- 内部接口不暴露公网
    location /internal/ {
        deny all;
    }

    # ------------------------------------------------ auth_request 子请求
    location = /_auth {
        internal;
        proxy_pass http://${JAVA_UPSTREAM}/internal/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Internal-Token "${M1_INTERNAL_TOKEN}";
        proxy_set_header Authorization $http_authorization;
    }
}
